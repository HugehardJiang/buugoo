# 复制为 .env 后填写。.env 已被 .gitignore 忽略，请勿提交。

# 聊天模型（DeepSeek）
BUUGOO_LLM__CHAT__API_KEY=
# 向量模型（硅基流动 BAAI/bge-m3）
BUUGOO_LLM__EMBEDDING__API_KEY=

# single 模式的访问密码（容器对外提供服务时务必设置）
BUUGOO_AUTH__ACCESS_PASSWORD=

# multi 模式必填：至少 32 位随机字符串，可用 `openssl rand -hex 32` 生成
BUUGOO_AUTH__JWT_SECRET=

# multi 模式：注册方式 open | invite | closed，以及每日限额
# BUUGOO_AUTH__REGISTRATION=invite
# BUUGOO_QUOTA__DAILY_MESSAGES=200
# BUUGOO_QUOTA__DAILY_TOKENS=200000

# docker-compose.mysql.yml 使用
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
